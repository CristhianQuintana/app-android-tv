<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug: HTTPS público por defecto (certificados del sistema).
  Cleartext solo para override LAN opcional (-PCOTAS_API_BASE_URL=http://…).
  Release: cleartext off (res/xml/network_security_config.xml).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.10.0.31</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
